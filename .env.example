# Binance Futures USDT-M API keys (copy to .env and fill in)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Optional: override the REST/WS base (mainnet default)
FAPI_BASE=https://fapi.binance.com

# Optional: default entry size (CLI flags override these)
# WALLET_PCT = entry as % of wallet balance (used when BASE_SIZE=0)
WALLET_PCT=10
# BASE_SIZE = fixed base order size in USDT (0 = use WALLET_PCT)
BASE_SIZE=0
# Per-symbol size boost via .state/boost/SYMBOL.json
# When a file exists, entry+DCA base_size is multiplied at arm time.
# SIZE_BOOST_DEFAULT=1.5   # /boost SYMBOL with no number uses this
# SIZE_BOOST_MAX=5         # hard cap on multiplier
# Auto (scanner): strict-eligible ★ + dwell ≥ N cycles + only #1 by score.
# Manual /boost is never overwritten. Auto TTL clears / leave-top clears auto.
# SIZE_BOOST_AUTO=1
# SIZE_BOOST_AUTO_DWELL=2          # consecutive ★ cycles (60s watch ≈ 2 min)
# SIZE_BOOST_AUTO_TTL_H=5          # hours
# Strict gates (defaults = ./pump-stall-watch):
# SIZE_BOOST_STRICT_STALL=35
# SIZE_BOOST_STRICT_NEAR=85
# SIZE_BOOST_STRICT_IDEAL=92
# SIZE_BOOST_STRICT_REGIME=80
# SIZE_BOOST_STRICT_SHARP=35
# SIZE_BOOST_STRICT_PUMP=35

# Optional: keep your account's LONG/SHORT exposure balanced.
# MAX_IMBALANCE = max allowed % difference between total LONG and SHORT notional
# across ALL open positions: |LONG - SHORT| / (LONG + SHORT) * 100.
# Before opening, if adding to the heavier side would exceed this, that side is
# skipped (the lighter side is still allowed since it rebalances). 0 = off.
# Override at runtime with --force.
# e.g. LONG 748 vs SHORT 349 => ~36% difference => new LONG skipped when MAX_IMBALANCE=20
MAX_IMBALANCE=20

# Account risk guards (futures) — 0 disables each check. --force overrides blocks.
# MAX_MARGIN_PCT=50           # skip if projected initial margin / balance > 50%
# MIN_LIQ_DISTANCE_PCT=20     # skip if any position is closer than 20% to liquidation
# Binance UI Margin Ratio (maint/equity %%; liquidates near 100%):
# MARGIN_RATIO_SOFT=5         # ≥ this → no new grids / ★ launches
# MARGIN_RATIO_HARD=8         # ≥ this → cancel open DCA limits (keep TP/BE/trail);
#                             # when it drops back below hard → re-arm DCA
# MAX_ACCOUNT_NOTIONAL_PCT=80 # skip if total |notional| + grid > wallet×lev×80%
# RISK_USE_FULL_GRID=true       # use full DCA grid notional in checks (not entry only)

# Optional (--supervise): when flat but a grid can't be armed (imbalance guard,
# no walls...), wait this many seconds before retrying instead of --tp-poll-sec.
# Avoids hammering the API / spamming logs. Default 60.
REARM_BACKOFF=60

# Supervise / exit poll interval (seconds). Slower = less Binance REST weight.
# With ~8 symbols, 15s stays under the 2400 weight/min IP limit more reliably.
# Override CLI: --tp-poll-sec. Alias for staged-only: STAGED_POLL_SEC.
TP_POLL_SEC=15

# Base/entry LIMIT order auto-expires via GTD (seconds). DCA safety orders stay GTC.
# If entry expires unfilled, --supervise cancels the orphan DCA grid and re-arms.
# 0 = no GTD (all orders use GTC). Default 1h. Min 600 for GTD.
# Tip: with GRID_TTL below, set ORDER_TTL=0 so refresh is proactive (not only on entry expiry).
ORDER_TTL=3600
# Flat armed grid refresh (Futures + Spot): cancel + re-arm at current book walls after N seconds.
# --supervise only, while flat. 0 = off. Default 1h.
GRID_TTL=3600

# --- Futures bot defaults (orderbook_dca_grid.py) -------------------------
# Exit mode for --supervise / pump-stall auto-trade children:
#   structure | staged | trailing | ob | pullback | ratchet | be | none
# TRADE_EXIT wins for pump-stall-watch; EXIT_MODE is the shared fallback.
# TRADE_EXIT=pullback
# EXIT_MODE=structure
# Concurrent ★ auto-trade slots (pump-stall-watch). Overrides unit --max-trades.
# MAX_TRADES=3
# Empty futures book → only 1 ★ at this mult (via .state/boost). Default 2.
# While any size boost is active, slots stay capped at 1 (won't fill MAX_TRADES).
# PUMPSTALL_EMPTY_MULT=2
# Post-BE trail (structure): arm at profit % / trailing callbackRate %
# POST_BE_ARM_PCT=1.5
# POST_BE_CALLBACK=0.6
# --exit pullback: close after adverse giveback %% from favorable extreme
# PULLBACK_PCT=0.4
# PULLBACK_MIN_PROFIT_PCT=0.3
# --exit ratchet: move SL to previous support/resistance as walls break
# RATCHET_BREAK_PCT=0.15
# RATCHET_MIN_PROFIT_PCT=1.0   # arm floor (like BE_ARM_PCT); lock uses BE_PROFIT_PCT=0.3
# RATCHET_WALL_MIN_MULT=1.0
# Binance recvWindow (default 15000; lower if your clock is very tight)
# RECV_WINDOW=15000
# DIRECTION=auto

# --- Staged exit (--exit staged / EXIT_MODE=staged) -----------------------
# TP1_PROFIT_PCT=0.3
# TP_PARTIAL_PCT=70
# Arm partial TP when position notional ≥ this %% of entry base (500 = 5× entry).
# Scales with wallet/% sizing. Absolute override: PARTIAL_TP_MIN_NOTIONAL=500
# PARTIAL_TP_MIN_ENTRY_PCT=500
# BE_PROFIT_PCT=0.1
# SL_PCT=2
# STAGED_POLL_SEC=15

# ATH stop-loss (SHORT) — replaces old risk-reduce partial cut (RR)
# One full-size STOP at historical ATH + RISK_ATH_SL_PCT (default +2%).
# New opens blocked when price is within RISK_ATH_ENTRY_MIN_GAP_PCT of ATH (default 12%).
# RISK_REDUCE=1
# RISK_ATH_SL_PCT=2
# RISK_ATH_ENTRY_MIN_GAP_PCT=12

# systemd pair lists — used by deploy/sync_pairs.py (enable/start listed, disable the rest)
# Comment out a line entirely to leave that market untouched by sync.
# FUTURES_UNIT=dca-futures   # override if needed (default in sync_pairs.py)
FUTURES_PAIRS=1000SHIBUSDT,ATOMUSDT,AVAXUSDT,DOGEUSDT,EIGENUSDT,ETCUSDT,NEARUSDT,OPUSDT,SUIUSDT,XRPUSDT

# --- Orderbook Trading API (iOS app · api_server.py) ----------------------
# Required to start the HTTP control plane used by the Flutter app.
# API_TOKEN=change-me-to-a-long-secret
# API_HOST=0.0.0.0
# API_PORT=8787
# Run: python3 api_server.py
# Auth: Authorization: Bearer <API_TOKEN>

# --- Telegram (alerts + remote control) -----------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=                 # private: botctl (/pump /report) + bank notices
# Public Pumpstall Free channel — IDEAL / #OPEN #DCA #TP #BE #TRAIL #SL #CLOSE #REPORT (%% only)
# TELEGRAM_PUMPSTALL_CHAT_ID=@pumpstall
# TELEGRAM_OPS_TRADE_ALERTS=0       # 1 = also mirror Vol/qty trade alerts to TELEGRAM_CHAT_ID
# PUMPSTALL_SITE_URL=https://pumpstall.idoneo.dev
# PUMPSTALL_TZ=Europe/Madrid
# PUMPSTALL_SUMMARY_HOUR=8
# After #REPORT: move this %% of yesterday net futures PnL (realized+fees) to spot
# PUMPSTALL_BANK_PCT=30
# PUMPSTALL_BANK_MIN_USDT=1
# Block new ★ auto-trade Fri 21:00 UTC → Sun 23:00 UTC (1=on, 0=off)
# Telegram #MARKET notice on enter/exit (English) when --telegram is on
# PUMPSTALL_WEEKEND_BLOCK=1
# --exit ob: OB Long / Short imbalance thresholds (0..1) + depth band %%
# IMB_LONG=0.55
# IMB_SHORT=0.45
# OB_BAND_PCT=1.0
# OB_MIN_PROFIT_PCT=0.3   # min gross %% before OB-flip close (+ TP_FEE_BUFFER net>0)
# Private stats for unlisted Pumpstall /stats (trades + exit modes)
# PUMPSTALL_STATS_PATH=.state/pumpstall_stats.json
# Prefer HTTPS push (VPS :8787 is usually firewalled from the web host):
# PUMPSTALL_STATS_PUSH_URL=https://pumpstall.com/api/pumpstall-stats
# PUMPSTALL_STATS_PUSH_TOKEN=   # same secret as site PUMPSTALL_SCAN_TOKEN (or API_TOKEN)
# Optional: GET /pump-stall-stats on api_server (Bearer API_TOKEN) if port is open
# Watch: ./pump-stall-watch-early   # includes --telegram
# One-shot ★: python3 pump_stall_scan.py --telegram
# Force summary: python3 -c "import pumpstall_telegram as p; p.maybe_send_daily_summary(force=True)"
# Force bank:    python3 -c "from pumpstall_bank import maybe_bank_profits_to_spot as b; print(b(force=True))"
# BOTCTL_MODE=auto      # auto | systemd | pidfile
# TELEGRAM_MIN_OPEN_VOL=5
# DEEPSEEK_API_KEY=          # pick — one volatile trade (skips FUTURES_PAIRS fleet)
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE=https://api.deepseek.com
# Run daemon: python3 telegram_botctl.py
# CLI:        python3 botctl.py start|stop|status|fib SXTUSDT
# Telegram:   /start SYMBOL · /fib SYMBOL [long|short] · /stop SYMBOL
# Fib guide:  OBMICRO_GRID_COMMANDS.md

# --- Fib micro-grid (orderbook_micro_grid.py · ./fib) -------------------------
# OB_MG_FIB_INTERVAL=5m
# OB_MG_ARM_MAX_FIB=0.236
# OB_MG_WAIT_PULLBACK=1
# OB_MG_PROTECT_TRAIL=1
# OB_MG_PROTECT_TRAIL_CALLBACK=0.2
# OB_MG_PROTECT_TRAIL_MAX_AGE_H=6   # also arm trail after N hours open (0=off)
# OB_MG_TP_PCT=0.30
# OB_MG_TP_FEE_PCT=0.08
# OB_MG_COOLDOWN_SEC=3600
# OB_MG_LEVELS=4
# OB_MG_ENTRY_USDT=0
# Scan:       fscan / python3 futures_scan.py
# Scalp pick: ./obscalp-pick          # fscan pool + score → optional full stack
#             ./obscalp-pick -y       # pick best + autotune/watch/bot
#             ./obscalp-pick --daemon --at 08:00,14:00,20:00 -y   # also picks on PM2 start
#             ./obscalp-pick --daemon -y --no-on-start            # schedule/idle only
# Follow log (pick + active symbol until switch):
#             ./obscalp-follow --daemon && tail -f .run/logs/scalp_follow.log
# AI pick:    pick / python3 trade_pick.py  (needs DEEPSEEK_API_KEY)
# AI review:  review NEARUSDT  — situational analysis for open position (needs DEEPSEEK_API_KEY)

# --- OB scalp (orderbook_ob_scalp.py) — separate from DCA grid ----------------
# SCALP_WALLET_PCT=2       # with --size-mode wallet
# SCALP_BASE_SIZE=25       # with --size-mode fixed (USDT notional)
# SCALP_SIZE_MODE=fixed    # min | wallet | fixed
# OB_BAR_SEC=60            # internal bar length (seconds)
# OB_SAMPLE_SEC=2          # depth poll interval while building a bar
# OB_BAND_PCT=1            # book band around mid for imbalance
# OB_IMB_LONG=0.55         # enter long when bid share >= this
# OB_IMB_SHORT=0.45        # enter short when bid share <= this
# OB_TP_PCT=0.35           # take profit %
# OB_SL_PCT=0.25           # stop loss %
# OB_TRAIL_PCT=0.08        # trailing stop distance % once armed
# OB_TRAIL_ARM_PCT=0.10    # arm trail after this profit % (default: tp/2)
# OB_FEE_BUFFER=0.12       # round-trip fee+slippage %%; skip TP/flip/trail if gross - buffer <= 0
# OB_RECOVER=1              # double size after losing close until TP (same side only)
# OB_RECOVER_MAX_LEVEL=4    # cap at 16x base notional
# OB_RECOVER_LOCK_MIN=5     # minutes same-side lock after SL (then both sides; size stays)
# OB_ENTRY_COOLDOWN_SEC=25  # wait after close before re-entry
# OB_EMA_FILTER=0           # 0=off (more entries); 1=require 1m EMA trend
# OB_ML_MIN_PROB=0.20       # lower = more ML-allowed entries
# OB_EMA_FAST=7             # fast EMA period
# OB_EMA_SLOW=25            # slow EMA period
# OB_EMA_SLOPE_BARS=5       # bars for fast EMA slope
# OB_EMA_SLOPE_MIN=0.05     # min slope % for bullish/bearish
# Logs: .run/logs/SYMBOL/scalp_trades.log + scalp_recovery.json + scalp_ema.log + scalp_bars.jsonl
# ML autotune: pip install -r requirements-ml.txt  →  ./obscalp-autotune ZECUSDT --execute
# Adaptive filters (default on): permissive start, relax when idle, learn from trades
# OB_ADAPTIVE=1
# OB_IMB_FILTER=1              # optional: re-enable book imbalance gate on scalp
# Unified log: ./obscalp-watch ZECUSDT --console  |  tail -f .run/logs/SYMBOL/scalp_session.log
# Trade sounds (macOS afplay):
# OB_SOUNDS=1
# OB_SOUND_PACK=pacman          # uses sounds/pacman/ in project (bundled mp3)
# PACMAN_SFX_DIR=/path/to/mp3   # optional override
# Or set each: OB_SOUND_ENTRY= OB_SOUND_DCA= OB_SOUND_TP= OB_SOUND_SL=
# Mute live (no bot restart): ./obscalp-sounds mute | unmute | status
# Pattern filter (5m continuity/volume + 15m FVG/BB/ATR): OB_PATTERN_FILTER=1 (default on)
# OB_PATTERN_MIN_BODY_RATIO=0.30  OB_PATTERN_MIN_VOL_RATIO=0.75  OB_PATTERN_MIN_CONTINUITY=1
# OB_PATTERN_INTERVAL=5m  OB_PATTERN_FVG_INTERVAL=15m  OB_MAX_BARS=12
# Run: obscalp BTCUSDT --dry-run  |  obscalp HEIUSDT --execute --bar-sec 15

SPOT_PAIRS=BNBUSDT,BTCUSDT,ETHUSDT,SOLUSDT

# --- SPOT bot only (orderbook_dca_grid_spot.py) --------------------------
# Same API keys as futures (needs "Spot & Margin Trading" permission).
# Optional: override the Spot REST base (mainnet default)
SPOT_BASE=https://api.binance.com
# OCO exit + swing-style buy ladder (kept while holding until TP fills):
# SPOT_TP = min take-profit % above avg (TP sits on an ask wall at/above it).
# Default 1.5 so each round clears typical spot fees (~0.2% round-trip).
SPOT_TP=1.5
# Wider spacing = fewer, more visible DCA buys (swing, not scalp).
SPOT_MIN_GAP=0.8
SPOT_MAX_RANGE=15
# Flat-only: refresh an unfilled buy grid after this many seconds (default 4h).
# While holding, DCA buys are NOT cancelled by TTL — they stay until TP.
# GRID_TTL=14400
# Spot exit: default is take-profit ONLY (no stop-loss). Set SPOT_NO_SL=0 to use
# classic OCO (LIMIT_MAKER TP + STOP_LOSS_LIMIT). When SL is on, the stop sits
# BELOW the whole DCA grid; SPOT_SL is the fallback %% below avg when the grid
# is fully filled; SPOT_SL_BUFFER is the cushion under the grid bottom.
SPOT_NO_SL=1
SPOT_SL=5
SPOT_SL_BUFFER=0.5
# Floor for the wallet-% entry size: if WALLET_PCT of free USDT is below this,
# use this many USDT instead (keeps orders above minNotional). Default 10.
MIN_BASE_USDT=10
# DCA count comes from the real walls in the book (a level is a wall if its size
# is ≥ SO_WALL_MULT × median book size). SO_MAX is only a safety cap (0 = no cap).
SO_MAX=15
SO_WALL_MULT=2
# Max invested per symbol. Prefer a % of the wallet (total USDT); the absolute
# Per-symbol exposure cap (Spot): holding + full grid cost must fit.
# MAX_SYMBOL_PCT = % of total USDT wallet (default 25%). Deepest DCAs are trimmed if needed.
# MAX_SYMBOL_USDT is a fallback used only when MAX_SYMBOL_PCT=0. 0 on both = no cap.
MAX_SYMBOL_PCT=25
MAX_SYMBOL_USDT=0
