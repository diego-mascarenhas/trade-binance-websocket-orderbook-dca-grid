[Unit]
Description=Pump→stall EARLY profile (prod default · lower stall/near · ★ shorts)
After=network-online.target
Wants=network-online.target

# Do NOT enable alongside pump-stall-watch — only one scanner.
# This unit is the production default; pump-stall-watch is the strict fallback.

[Service]
Type=simple
User=forge
WorkingDirectory=/opt/trade-binance-websocket-orderbook-dca-grid
EnvironmentFile=-/opt/trade-binance-websocket-orderbook-dca-grid/.env
# ★ slots via .env MAX_TRADES · early stall thresholds
# Exit: --trade-exit ratchet (BE floor + wall SL). CLI wins over TRADE_EXIT/EXIT_MODE.
# Optional overlay: add --also-structure to the unit to let EQL/EQH close earlier.
# Margin Ratio (Binance UI): soft 3% no new ★ · hard 5% strip DCA / re-arm below
ExecStart=/usr/bin/python3 -u /opt/trade-binance-websocket-orderbook-dca-grid/pump_stall_scan.py \
  --watch \
  --auto-trade \
  --telegram \
  --trade-exit ratchet \
  --interval 60 \
  --loss-cooldown-min 1440 \
  --margin-ratio-soft 3 \
  --margin-ratio-hard 5 \
  --min-stall 25 \
  --min-near-high 82 \
  --ideal-near 90 \
  --why 20
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
