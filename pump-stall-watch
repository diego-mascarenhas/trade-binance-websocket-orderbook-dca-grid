#!/usr/bin/env bash
# Live pump→stall supervisor (refreshes on screen).
# Usage: ./pump-stall-watch [--interval 60] [--top 12] …
# Auto-trade (option C): ./pump-stall-watch --auto-trade [--max-trades 2]
#   → top N ★ from this list only (other account pairs ignored)
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "$ROOT/pump_stall_scan.py" --watch "$@"
