#!/usr/bin/env bash
# Short wrapper: dca SYMBOL [long|short|auto|stop|status|cleanup|sweep] [flags...]
set -euo pipefail

# Resolve symlinks so PATH installs (e.g. ~/bin/dca → repo/dca) find the repo.
_SRC="${BASH_SOURCE[0]}"
while [[ -L "$_SRC" ]]; do
  _DIR="$(cd "$(dirname "$_SRC")" && pwd)"
  _SRC="$(readlink "$_SRC")"
  [[ "$_SRC" != /* ]] && _SRC="$_DIR/$_SRC"
done
ROOT="$(cd "$(dirname "$_SRC")" && pwd)"
cd "$ROOT"

usage() {
    echo "Usage: dca SYMBOL [long|short|auto|stop|status|cleanup|sweep] [flags...]"
    echo "  dca 1000PEPEUSDT                         # AUTO supervisor (default)"
    echo "  dca 1000PEPEUSDT short                   # SHORT supervisor"
    echo "  dca BANKUSDT short --gate-price 0.29332  # SHORT only if mid > gate"
    echo "  dca SKLUSDT stop                         # stop supervisor (orders stay)"
    echo "  dca SKLUSDT status                       # process + trading state"
    echo "  dca SKLUSDT cleanup                      # cancel obstage* Stop/TP algos"
    echo "  dca REUSDT sweep                         # cancel orphan bot orders if flat"
    exit 1
}

[[ $# -lt 1 ]] && usage

SYMBOL="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
shift

ACTION="auto"
if [[ $# -gt 0 ]]; then
    case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        stop | status | cleanup | sweep | long | short | auto)
            ACTION="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
            shift
            ;;
    esac
fi

case "$ACTION" in
    stop | status | cleanup)
        exec python3 "$ROOT/botctl.py" "$ACTION" "$SYMBOL" "$@"
        ;;
    sweep)
        exec python3 "$ROOT/botctl.py" sweep "$SYMBOL" "$@"
        ;;
    long | short | auto)
        exec python3 -u "$ROOT/orderbook_dca_grid.py" "$SYMBOL" \
            --supervise \
            --direction "$ACTION" \
            --recv-window 15000 \
            "$@"
        ;;
    *)
        echo "Second arg must be long, short, auto, stop, status, cleanup, or sweep" >&2
        usage
        ;;
esac
